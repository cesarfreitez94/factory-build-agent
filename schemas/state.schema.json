{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FBA Project State",
  "description": "State machine schema for Factory Build Agent project state",
  "type": "object",
  "required": ["project", "current_phase", "methodology", "phases", "artifacts"],
  "definitions": {
    "phase": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["pending", "in_progress", "complete", "failed"]},
        "agent": {"type": "string"},
        "command": {"type": "string", "description": "Slash command to invoke the agent"},
        "type": {"enum": ["interactive", "batch"], "description": "Execution mode"},
        "questions_file": {"type": "string", "description": "Path to questions JSON (interactive phases only)"},
        "answers_file": {"type": "string", "description": "Path to answers JSON (interactive phases only)"},
        "output_file": {"type": "string", "description": "Path to phase output artifact (interactive phases only)"}
      }
    }
  },
  "properties": {
    "project": {
      "type": "string",
      "description": "Project name (directory name by default)"
    },
    "framework_version": {
      "type": "string",
      "description": "Version of FBA framework used"
    },
    "init_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of initialization"
    },
    "current_phase": {
      "type": "string",
      "enum": ["init", "elicitation", "documentation", "planning", "tasks", "construction", "testing", "review", "ci_cd", "complete"],
      "description": "Current phase of the development lifecycle"
    },
    "methodology": {
      "type": "string",
      "description": "Elicitation methodology in use (e.g. BABOK, JTBD, User Story Mapping, DDD)"
    },
    "phases": {
      "type": "object",
      "description": "Status of each phase",
      "properties": {
        "init": {"$ref": "#/definitions/phase"},
        "elicitation": {"$ref": "#/definitions/phase"},
        "documentation": {"$ref": "#/definitions/phase"},
        "planning": {"$ref": "#/definitions/phase"},
        "tasks": {"$ref": "#/definitions/phase"},
        "construction": {"$ref": "#/definitions/phase"},
        "testing": {"$ref": "#/definitions/phase"},
        "review": {"$ref": "#/definitions/phase"},
        "ci_cd": {"$ref": "#/definitions/phase"}
      }
    },
    "valid_transitions": {
      "type": "object",
      "description": "Mapping of phase to list of allowed next phases",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"}
      }
    },
    "artifacts": {
      "type": "object",
      "description": "Generated artifacts and their status",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {"type": "string", "enum": ["draft", "valid", "published"]},
          "version": {"type": "integer"}
        }
      }
    },
    "context": {
      "type": "object",
      "description": "Arbitrary key-value context for the current phase"
    },
    "gates": {
      "type": "object",
      "description": "Gate definitions per phase. Gates are evaluated before transitioning out of a phase.",
      "additionalProperties": {
        "type": "object",
        "required": ["description", "owner_agent", "rules"],
        "properties": {
          "description": {
            "type": "string",
            "description": "Human-readable description of what this gate validates"
          },
          "owner_agent": {
            "type": "string",
            "description": "Agent responsible for fixing failures (e.g. documentador, planificador)"
          },
          "rules": {
            "type": "array",
            "description": "Ordered list of validation rules to evaluate",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["schema", "artifact_exists", "traceability", "content_check", "semantic_check", "task_files_exist", "view_coverage", "view_field_check", "acl_coverage"],
                  "description": "Rule evaluation type"
                },
                "rule_name": {
                  "type": "string",
                  "description": "Optional display name for the rule"
                },
                "path": {
                  "type": "string",
                  "description": "Path to the artifact file (relative to project dir)"
                },
                "schema": {
                  "type": "string",
                  "description": "Schema file name (for schema rule type)"
                },
                "prd_path": {
                  "type": "string",
                  "description": "Path to PRD JSON (for traceability rule type)"
                },
                "sdd_path": {
                  "type": "string",
                  "description": "Path to SDD JSON (for traceability rule type)"
                },
                "checks": {
                  "type": "object",
                  "description": "Content checks mapping (for content_check rule type)",
                  "additionalProperties": {"type": "integer"}
                },
                "source_path": {
                  "type": "string",
                  "description": "Path to the source artifact for comparison (for semantic_check rule type)"
                },
                "target_path": {
                  "type": "string",
                  "description": "Path to the target artifact to validate (for semantic_check rule type)"
                },
                "dimensions": {
                  "type": "array",
                  "description": "Semantic dimensions to evaluate (for semantic_check rule type)",
                  "items": {"type": "string"}
                },
                "index_path": {
                  "type": "string",
                  "description": "Path to the task index JSON (for task_files_exist rule type)"
                }
              }
            }
          }
        }
      }
    }
  }
}
