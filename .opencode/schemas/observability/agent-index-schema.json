{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FBA Agent Index",
  "description": "Schema for agent-index.json generated by fba-agent-observer plugin",
  "type": "object",
  "required": ["generatedAt", "observedDirectory", "ignoredDirectory", "agents"],
  "properties": {
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of index generation"
    },
    "observedDirectory": {
      "type": "string",
      "description": "Directory being observed for agents"
    },
    "ignoredDirectory": {
      "type": "string",
      "description": "Directory excluded from observation"
    },
    "agents": {
      "type": "array",
      "description": "List of observed agent definitions",
      "items": {
        "type": "object",
        "required": ["name", "path", "description", "mode", "hidden", "promptHash", "fileHash"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Agent identifier"
          },
          "path": {
            "type": "string",
            "description": "Relative path to agent definition file"
          },
          "description": {
            "type": "string",
            "description": "Agent role description from frontmatter"
          },
          "mode": {
            "type": "string",
            "enum": ["primary", "subagent", "all"],
            "description": "Agent operational mode"
          },
          "hidden": {
            "type": "boolean",
            "description": "Whether agent is hidden from UI"
          },
          "promptHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$",
            "description": "SHA256 hash of agent prompt body (first 16 chars)"
          },
          "fileHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$",
            "description": "SHA256 hash of entire file (first 16 chars)"
          },
          "promptSnapshot": {
            "type": "string",
            "description": "Optional captured prompt body for change detection"
          }
        }
      }
    }
  }
}
